{
  "manifest_file": "data/processed/group_samples.csv",
  "output_dir": "artifacts/group_model",
  "baseline_metrics_file": "artifacts/baselines/metrics.json",
  "label_columns": ["form_A", "form_B", "form_C", "form_D"],
  "geometry_columns": [
    "group_size",
    "geom_center_x",
    "geom_center_y",
    "geom_union_width",
    "geom_union_height",
    "geom_union_area",
    "geom_mean_member_width",
    "geom_mean_member_height",
    "geom_center_std_x",
    "geom_center_std_y",
    "geom_pair_distance_mean",
    "geom_pair_distance_max"
  ],
  "image_size": 224,
  "batch_size": 16,
  "epochs": 25,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "dropout": 0.30,
  "hidden_dim": 128,
  "threshold": 0.50,
  "positive_weight_cap": 10.0,
  "patience": 6,
  "freeze_backbone": true,
  "pretrained": true,
  "num_workers": 0,
  "seed": 42,
  "device": "auto"
}
